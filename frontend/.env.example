# Copy to frontend/.env:   cp .env.example .env
# Vite exposes only VITE_* variables to the browser — never put secrets here.

# Backend API base URL (default: http://localhost:8000/api)
VITE_API_URL=
# Show the demo-account shortcuts on the login page: true | false (default: shown unless "false")
VITE_SHOW_DEMO_ACCOUNTS=

# Test tooling reads these from the shell environment (not from this file):
#   E2E_BASE_URL   frontend URL for Playwright (default: http://localhost:5173)
#   E2E_API_URL    API URL for Playwright (default: http://localhost:8000/api)
#   CHROME_PATH    Chrome/Chromium binary; by default Playwright uses the installed Google Chrome
#   SMOKE_API_URL  API URL for scripts/smoke_test.py (default: http://localhost:8000/api)
