# Copy to .env and fill in the values:   cp .env.example .env
# .env is git-ignored — never commit real secrets.

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_DB=campusbite
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=
BACKEND_PORT=8000

# --- Backend ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Business calendar for 'today', date filters, daily charts and AI date math (IANA name)
APP_TIMEZONE=Asia/Kolkata
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Load demo restaurants, users and orders on startup (idempotent)
SEED_DEMO_DATA=true

# --- OpenAI (AI order insights) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_RATE_LIMIT_PER_MINUTE=5

# --- Background reminders ---
ENABLE_REMINDER_SCHEDULER=true
REMINDER_THRESHOLD_MINUTES=15
REMINDER_CHECK_INTERVAL_SECONDS=60

# --- Email OTP (signup verification + login second step) ---
# console = codes are printed in the backend logs (docker compose logs -f backend)
# email   = sent via SMTP (Gmail: smtp.gmail.com:587 with an App Password). If any SMTP value
#           is missing the backend logs a warning and falls back to console.
OTP_DELIVERY=console
OTP_ON_LOGIN=true
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=CampusBite
FRONTEND_URL=http://localhost:5173
# /auth/login, the verify endpoints and resend: max requests per IP + email per window
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=600
