# Copy to .env and fill in the values:   cp .env.example .env
# Variable names only — never commit real values. .env is git-ignored.
# Read by Docker Compose (db + backend containers).

# --- PostgreSQL (Docker Compose) ---
# Required: any strong password
POSTGRES_PASSWORD=
# Database name and user (default: campusbite)
POSTGRES_DB=
POSTGRES_USER=
# Host port for the API (default: 8000)
BACKEND_PORT=
# Load the Lucknow demo data on startup: true | false (default: false). Idempotent.
SEED_DEMO_DATA=

# DATABASE_URL is built by docker-compose.yml from the POSTGRES_* values above.

# --- Backend: required ---
# JWT signing key, 32+ characters. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Backend: optional (leave blank to use the default shown) ---
# App name shown in the API docs (default: CampusBite API)
APP_NAME=
# development | production (default: development)
ENVIRONMENT=
# DEBUG | INFO | WARNING (default: INFO)
LOG_LEVEL=
# Business timezone for "today", date filters and charts, IANA name (default: Asia/Kolkata)
APP_TIMEZONE=
# JWT algorithm (default: HS256)
JWT_ALGORITHM=
# Token lifetime in minutes (default: 720)
ACCESS_TOKEN_EXPIRE_MINUTES=
# bcrypt cost factor 4–16 (default: 12)
BCRYPT_ROUNDS=
# Comma-separated frontend origins allowed by CORS (default: http://localhost:5173,http://127.0.0.1:5173)
CORS_ORIGINS=
# Delivery fee added to every order, in rupees (default: 40)
DELIVERY_FEE=
# Tax rate on the subtotal, e.g. 0.05 = 5% (default: 0.05)
TAX_RATE=
# Login attempts allowed per client IP + email within the window (default: 10 per 600 s)
LOGIN_RATE_LIMIT=
LOGIN_RATE_WINDOW_SECONDS=

# --- OpenAI (AI order insights). Without a key the AI endpoint returns 503 with a clear message. ---
OPENAI_API_KEY=
# Chat model (default: gpt-5.4-mini)
OPENAI_MODEL=
# Request timeout in seconds (default: 30)
OPENAI_TIMEOUT_SECONDS=
# Max tokens in an answer (default: 800)
OPENAI_MAX_OUTPUT_TOKENS=
# AI questions per customer per minute (default: 5)
AI_RATE_LIMIT_PER_MINUTE=
# Most recent orders sent as context; totals always use the full history (default: 50)
AI_CONTEXT_MAX_ORDERS=

# --- Background reminders for orders stuck in PLACED/ACCEPTED ---
# true | false (default: true)
ENABLE_REMINDER_SCHEDULER=
# Minutes without an update before a reminder is created (default: 15)
REMINDER_THRESHOLD_MINUTES=
# How often the job runs, in seconds (default: 60)
REMINDER_CHECK_INTERVAL_SECONDS=
